{
  "manifest_version": 2,
  "name": "Price checker",
  "version": "1.0",
  "description": "Track specific products price on specific websites",
  "icons": {
    "48": "icon.png"
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
